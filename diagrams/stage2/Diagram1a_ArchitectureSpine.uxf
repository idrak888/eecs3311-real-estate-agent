    <panel_attributes>RealEstateService
--
-repository: ListingRepository
-importer: ListingImporter
-store: PreferenceStore
-calculator: MortgageCalculator
-invoker: CommandInvoker
-shortlist: Shortlist
-criteria: SearchCriteria
-results: List&lt;Listing&gt;
-strategy: RankingStrategy
-profile: FinancialProfile
-agent: AdvisorAgent
-extractor: RequirementExtractor
-observers: List&lt;SearchObserver&gt;
--
+create(PreferenceStore, LLMClient): RealEstateService
+loadListings(File): LoadSummary
+restoreSession(): List&lt;String&gt;
+search(SearchCriteria): List&lt;Listing&gt;
+refine(SearchCriteria): List&lt;Listing&gt;
+diagnoseNoResults(): Optional&lt;Diagnosis&gt;
+setRankingStrategy(RankingStrategy): void
+getListing(String): Optional&lt;Listing&gt;
+availableNeighborhoods() / availableFeatures(): List&lt;String&gt;
+askAgent(String): AgentResponse
+compare(List&lt;String&gt;): AgentResponse
+calculateMortgage(String, MortgageTerms): MortgageResult
+setFinancialProfile(FinancialProfile): void
+assessAffordability(String, FinancialProfile): AffordabilityResult
+addToShortlist(String) / removeFromShortlist(String): boolean
+executeCommand(ShortlistCommand): void
+undo(): Optional&lt;String&gt;
+addObserver(SearchObserver): void
-notifyObservers(): void
